/* cdie_gui.rc - resources for the WinAPI GUI: the common-controls v6 manifest
 * (so the standard controls render themed) and version information. rc.exe
 * resolves the manifest path relative to this .rc file's own directory. */

#include <windows.h>
#include "resource.h"

/* 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST. */
1 24 "cdie_gui.manifest"

/* Detect It Easy icon. */
IDI_CDIE ICON "images/main.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4, 1, 0, 0
 PRODUCTVERSION 4, 1, 0, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NTInfo"
            VALUE "FileDescription", "Detect It Easy console engine (C port) - GUI"
            VALUE "FileVersion", "4.1.0.0"
            VALUE "InternalName", "die"
            VALUE "LegalCopyright", "Copyright (C) 2026 hors"
            VALUE "OriginalFilename", "die.exe"
            VALUE "ProductName", "cdie"
            VALUE "ProductVersion", "4.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
