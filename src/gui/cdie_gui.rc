/* cdie_gui.rc - resources for the WinAPI GUI: the common-controls v6 manifest
 * (so the standard controls render themed) and version information. rc.exe
 * resolves the manifest path relative to this .rc file's own directory. */

#include <windows.h>
#include "resource.h"

/* 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST. */
1 24 "cdie_gui.manifest"

/* Database folders complement the common xxwidgets scan Options form. */
IDD_OPTIONS DIALOGEX 0, 0, 316, 157
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Database paths"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Main database:", -1, 8, 13, 72, 9
    EDITTEXT        IDC_OPT_MAIN, 82, 11, 190, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_OPT_MAIN_BROWSE, 276, 10, 32, 15
    LTEXT           "Extra database:", -1, 8, 33, 72, 9
    EDITTEXT        IDC_OPT_EXTRA, 82, 31, 190, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_OPT_EXTRA_BROWSE, 276, 30, 32, 15
    LTEXT           "Custom database:", -1, 8, 53, 72, 9
    EDITTEXT        IDC_OPT_CUSTOM, 82, 51, 190, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_OPT_CUSTOM_BROWSE, 276, 50, 32, 15
    LTEXT           "Each path is the folder that holds the signature files. Leave a field blank to use the default folder next to the executable.",
                    -1, 8, 74, 300, 24
    LTEXT           "", IDC_OPT_ERROR, 8, 104, 300, 22
    DEFPUSHBUTTON   "OK", IDOK, 202, 135, 52, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 258, 135, 52, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4, 0, 0, 0
 PRODUCTVERSION 4, 0, 0, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NTInfo"
            VALUE "FileDescription", "Detect It Easy console engine (C port) - GUI"
            VALUE "FileVersion", "4.0.0.0"
            VALUE "InternalName", "cdie_gui"
            VALUE "LegalCopyright", "Copyright (C) 2026 hors"
            VALUE "OriginalFilename", "cdie_gui.exe"
            VALUE "ProductName", "cdie"
            VALUE "ProductVersion", "4.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
